rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dati dell'utente: legge e scrive solo lui.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Diritti dell'account: l'utente li LEGGE, non li scrive mai.
    // Si modificano solo dalla console Firebase, dall'Admin SDK o da una
    // Cloud Function (es. il webhook Stripe). Questo è il vero confine di
    // sicurezza: qualsiasi controllo nel browser è aggirabile.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
