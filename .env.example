# Compila questi valori con quelli del tuo progetto Firebase (Console > Impostazioni progetto > Le tue app > Web).
# Se lasci il file assente o i valori vuoti, GoalDrive parte in "modalità locale":
# account e dati restano sul dispositivo (localStorage), tutto il resto funziona identico.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
